# Copy to .env (never commit .env). Defaults work for a fully offline demo.

# --- Postgres / TimescaleDB ---
POSTGRES_USER=ward
POSTGRES_PASSWORD=ward
POSTGRES_DB=ward
# Used when running the backend outside Docker (inside Docker, compose overrides it):
DATABASE_URL=postgresql+psycopg://ward:ward@localhost:5432/ward

# --- MQTT ---
MQTT_HOST=localhost
MQTT_PORT=1883
# The broker requires a login and enforces per-topic ACLs (infra/mosquitto/acl). The password file is built from the
# three variables below when the mqtt container starts. These are public demo defaults: change them outside the demo
# (WARD_ENV=prod refuses to start on them). Compose passes the backend pair to the api and worker as MQTT_USERNAME /
# MQTT_PASSWORD; if you run the backend outside Docker, set MQTT_USERNAME / MQTT_PASSWORD to the same values.
MQTT_BACKEND_USERNAME=ward-backend
MQTT_BACKEND_PASSWORD=change-me-mqtt
# One device_id:password pair per bedside unit / simulator, comma-separated (the password may not contain a comma).
# The device id is also the MQTT username. The simulator and firmware must use the same pair.
MQTT_DEVICE_CREDENTIALS=bsu-001:change-me-bsu-001,bsu-002:change-me-bsu-002

# --- Environment ---
# demo keeps the default secrets below (warns only); prod refuses to start on any default secret
WARD_ENV=demo

# --- Auth ---
# Leaving the default gives a random secret per API restart (everyone must log in again). Set your own (>= 32 chars):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=8
# browser origin(s) allowed by CORS; https://<your domain> with the internet profile
WEB_ORIGIN=http://localhost:3000
# the hospital named on the sign-up form (GET /hospital); one install is one hospital
HOSPITAL_NAME=Ward Hospital
# bcrypt cost; tests use 4 for speed
BCRYPT_ROUNDS=12
# password of the synthetic seed accounts (contract default ward1234); change it outside the demo
SEED_PASSWORD=ward1234

# --- MinIO ---
MINIO_ROOT_USER=ward
MINIO_ROOT_PASSWORD=wardminio123
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=ward-docs

# --- n8n ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook/ward-events
N8N_EVENT_SECRET=change-me-event
N8N_CALLBACK_SECRET=change-me-callback
# n8n's public base URL: W2 accept links point here, so use the laptop's LAN IP for the demo (phones on the hotspot)
N8N_PUBLIC_URL=http://localhost:5678/

# WhatsApp notifications through WAHA (a WhatsApp account linked by QR code, dashboard http://localhost:3010/dashboard,
# login admin / WAHA_API_KEY). Numbers are digits only with the country code (216...).
WAHA_API_KEY=change-me-waha
WARD_WHATSAPP_STAFF=
# WARD_WHATSAPP_PATIENT takes a comma-separated list too.
WARD_WHATSAPP_PATIENT=
# Sender shown on n8n emails (Gmail SMTP overrides it with the account address)
WARD_MAIL_FROM=Ward <ward@localhost>

# --- AI ---
# optional, open models only; the AI works without it
# none = no LLM (default) · groq = Groq API (open models) · local = Ollama native API (/api/chat)
LLM_PROVIDER=none
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_LOCAL_BASE_URL=http://localhost:11434
LLM_LOCAL_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_S=15
# AI radiograph reading (local Ollama vision model only; images never leave the machine)
VISION_PROVIDER=none
LLM_VISION_MODEL=qwen3-vl:4b
LLM_VISION_TIMEOUT_S=180
RADIOLOGY_REPORT_LANG=fr
# Ollama on the host as seen from the containers
DOCKER_OLLAMA_URL=http://host.docker.internal:11434

# --- Web ---
# Base URL used in reminder links (use the laptop's LAN IP so phones on the demo hotspot can open it)
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=1

# --- Internet access (compose profile "internet"; see docs/superpowers/specs/2026-10-10-accounts-and-access-design.md §8)
# Leave these defaults for the offline demo. With the proxy: API_BIND=127.0.0.1, WEB_BIND=127.0.0.1,
# N8N_BIND=127.0.0.1, FORWARDED_ALLOW_IPS=* (safe only because the api port is then bound to localhost),
# WARD_ENV=prod, WEB_ORIGIN=https://<WARD_DOMAIN>, NEXT_PUBLIC_API_URL=https://<WARD_DOMAIN>/api
API_BIND=0.0.0.0
WEB_BIND=0.0.0.0
N8N_BIND=0.0.0.0
FORWARDED_ALLOW_IPS=127.0.0.1
WARD_DOMAIN=
# Env file the api/worker containers load (relative to repo root). For the internet profile set WARD_ENV_FILE=.env.internet
# in that file AND pass it with --env-file, so WARD_ENV=prod and the real secrets reach the containers.
WARD_ENV_FILE=.env
# MQTT uses plaintext logins: on a host with a public IP set MQTT_BIND to the LAN interface IP or 127.0.0.1 (or firewall 1883)
MQTT_BIND=0.0.0.0
# "internal" = self-signed CA for LAN testing; an email address = real Let's Encrypt certificate for WARD_DOMAIN
WARD_TLS=internal

# --- Host ports (change if something else on your laptop already uses them) ---
API_PORT=8000
WEB_PORT=3000

TZ=Africa/Tunis

# Health watch (weather-health alerts + health news). Open-Meteo, WHO and Google News RSS: free, no key.
# Only the city's coordinates leave the server. HEALTH_WATCH_DEMO=heatwave|dust|cold injects a labelled demo scenario.
HOSPITAL_CITY=Tunis
HOSPITAL_LAT=36.8065
HOSPITAL_LON=10.1815
HEALTH_WATCH_OFFLINE=false
HEALTH_WATCH_DEMO=
