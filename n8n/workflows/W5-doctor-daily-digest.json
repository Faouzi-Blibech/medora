{
  "id": "wardDigestW5xxxx",
  "name": "W5 · Doctor daily digest",
  "nodes": [
    {
      "id": "f5e0a1b2-0000-4000-8000-000000000501",
      "name": "Every day 07:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 7 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "f5e0a1b2-0000-4000-8000-000000000505",
      "name": "Run now",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        200
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "f5e0a1b2-0000-4000-8000-000000000502",
      "name": "daily-digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.WARD_API_URL }}/integrations/n8n/daily-digest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Secret",
              "value": "={{ $env.N8N_CALLBACK_SECRET }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 30000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "f5e0a1b2-0000-4000-8000-000000000503",
      "name": "One email per doctor",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "// GET daily-digest (contract v1.2): [{doctor: {id, name, email}, patients: [{name, bed, news2, summary}]}]\nconst res = $input.first().json;               // full response: {statusCode, body}\nif (res.statusCode !== 200 || !Array.isArray(res.body)) return [];\nconst WEB = ($env.WEB_URL || 'http://localhost:3000').replace(/\\/$/, '');\nconst today = DateTime.now().setZone('Africa/Tunis').toFormat('cccc d LLL');\nconst out = [];\nfor (const entry of res.body) {\n  const doc = entry.doctor || {};\n  const patients = [...(entry.patients || [])].sort((a, b) => (b.news2 ?? -1) - (a.news2 ?? -1));\n  if (!doc.email || !patients.length) continue;\n  const lines = patients.map(p => {\n    const flag = (p.news2 ?? 0) >= 5 ? '  <- review first' : '';\n    return `- Bed ${p.bed ?? '?'} · ${p.name ?? 'Patient'} · NEWS2 ${p.news2 ?? '-'}${flag}\\n  ${p.summary || 'No summary available.'}`;\n  });\n  const text = `Good morning ${doc.name ?? 'Doctor'},\\n\\nYour ${patients.length} admitted patient${patients.length > 1 ? 's' : ''} this morning, highest NEWS2 first.\\nSummaries are AI suggestions: review them before acting.\\n\\n${lines.join('\\n\\n')}\\n\\nOpen Medora: ${WEB}/doctor\\n\\n-- Medora`;\n  out.push({ json: { email: doc.email, subject: `Medora daily digest · ${today} · ${patients.length} patient${patients.length > 1 ? 's' : ''}`, text } });\n}\nreturn out;"
      }
    },
    {
      "id": "f5e0a1b2-0000-4000-8000-000000000504",
      "name": "Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        720,
        0
      ],
      "parameters": {
        "fromEmail": "={{ $env.WARD_MAIL_FROM }}",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "onError": "continueRegularOutput",
      "credentials": {
        "smtp": {
          "id": "wardSmtpCred0001",
          "name": "ward-smtp"
        }
      }
    }
  ],
  "connections": {
    "Every day 07:30": {
      "main": [
        [
          {
            "node": "daily-digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now": {
      "main": [
        [
          {
            "node": "daily-digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "daily-digest": {
      "main": [
        [
          {
            "node": "One email per doctor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One email per doctor": {
      "main": [
        [
          {
            "node": "Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Africa/Tunis"
  },
  "pinData": {},
  "tags": []
}
