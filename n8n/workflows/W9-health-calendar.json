{
  "id": "wardHealthCalW9x",
  "name": "W9 · Health calendar",
  "nodes": [
    {
      "id": "9c4e7b21-5d3a-4f68-a0b1-000000000901",
      "name": "From router",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "9c4e7b21-5d3a-4f68-a0b1-000000000902",
      "name": "Mark source",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "// event health_event.upcoming (router): {event_id, title, category, starts_on, ends_on, organizer, web_url, recipients[]}\nreturn $input.all().map(item => ({ json: { ...(item.json.data || {}), from_cron: false } }));"
      }
    },
    {
      "id": "9c4e7b21-5d3a-4f68-a0b1-000000000903",
      "name": "Daily 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        240
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "9c4e7b21-5d3a-4f68-a0b1-000000000904",
      "name": "health-events-due",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        240
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.WARD_API_URL }}/integrations/n8n/health-events/due",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Secret",
              "value": "={{ $env.N8N_CALLBACK_SECRET }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 30000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "9c4e7b21-5d3a-4f68-a0b1-000000000905",
      "name": "Split",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        240
      ],
      "parameters": {
        "jsCode": "// GET health-events/due (contract v1.4): [payload, ...], same shape as the health_event.upcoming event data\nconst res = $input.first().json;               // full response: {statusCode, body}\nif (res.statusCode !== 200 || !Array.isArray(res.body)) return [];\nreturn res.body.map(p => ({ json: { ...p, from_cron: true } }));"
      }
    },
    {
      "id": "9c4e7b21-5d3a-4f68-a0b1-000000000906",
      "name": "Compose",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        120
      ],
      "parameters": {
        "jsCode": "// One output item per health event. Only first names and emails of opted-in recipients are present.\nconst out = [];\nfor (const item of $input.all()) {\n  const d = item.json;\n  const title = (d.title && (d.title.fr || d.title.en)) || 'Evenement sante';\n  const range = d.ends_on && d.ends_on !== d.starts_on ? `${d.starts_on} → ${d.ends_on}` : `${d.starts_on}`;\n  const text = `📅 ${title} · ${range}${d.organizer ? ' · ' + d.organizer : ''}\n${d.web_url || ''}`;\n  out.push({ json: { event_id: d.event_id, title, text, recipients: d.recipients || [], from_cron: !!d.from_cron } });\n}\nreturn out;"
      }
    },
    {
      "id": "9c4e7b21-5d3a-4f68-a0b1-000000000907",
      "name": "One message per number",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "// Demo routing: every number in WARD_WHATSAPP_PATIENT and WARD_WHATSAPP_STAFF (comma-separated, country code first).\nconst nums = () => [...new Set((($env.WARD_WHATSAPP_PATIENT || '') + ',' + ($env.WARD_WHATSAPP_STAFF || '')).split(',').map(s => s.replace(/\\D/g, '')).filter(Boolean))];\nconst out = [];\nfor (const item of $input.all()) {\n  for (const to of nums()) out.push({ json: { to, text: item.json.text, event_id: item.json.event_id } });\n}\nreturn out;"
      }
    },
    {
      "id": "9c4e7b21-5d3a-4f68-a0b1-000000000908",
      "name": "WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WAHA_URL }}/api/sendText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{ $env.WAHA_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ session: 'default', chatId: $json.to + '@c.us', text: $json.text, linkPreview: false }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 15000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "9c4e7b21-5d3a-4f68-a0b1-000000000909",
      "name": "One per recipient",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        160
      ],
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const d = item.json;\n  for (const r of d.recipients || []) {\n    if (!r.email) continue;\n    out.push({ json: { email: r.email, subject: `Ward · ${d.title}`, text: `Bonjour ${r.first_name || ''},\n\n${d.text}` } });\n  }\n}\nreturn out;"
      }
    },
    {
      "id": "9c4e7b21-5d3a-4f68-a0b1-000000000910",
      "name": "Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1200,
        160
      ],
      "parameters": {
        "fromEmail": "={{ $env.WARD_MAIL_FROM }}",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "onError": "continueRegularOutput",
      "credentials": {
        "smtp": {
          "id": "wardSmtpCred0001",
          "name": "ward-smtp"
        }
      }
    },
    {
      "id": "9c4e7b21-5d3a-4f68-a0b1-000000000911",
      "name": "From cron?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        960,
        320
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "9c4e7b21-5d3a-4f68-a0b1-000000000a01",
              "leftValue": "={{ $json.from_cron }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "9c4e7b21-5d3a-4f68-a0b1-000000000912",
      "name": "Mark announced",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WARD_API_URL }}/integrations/n8n/health-events/{{ $json.event_id }}/announced",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Secret",
              "value": "={{ $env.N8N_CALLBACK_SECRET }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 15000
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
