      "parameters": {
        "jsCode": "// Contract: docs/contracts/n8n-webhooks.md v1.0. Unknown events or a bad secret are dropped.\nconst SECRET = $env.N8N_EVENT_SECRET;\nconst ROUTES = {\n  'alert.critical': 0,\n  'dose.missed': 1,\n  'appointment.confirmed': 2,\n  'appointment.cancelled': 3,\n  'patient.discharged': 4,\n  'health_event.upcoming': 5,\n};\nconst out = [];\nfor (const item of $input.all()) {\n  const headers = item.json.headers || {};\n  const body = item.json.body || {};\n  if (!SECRET || headers['x-ward-secret'] !== SECRET) continue;\n  if (!(body.event in ROUTES)) continue;\n  out.push({ json: { event: body.event, ts: body.ts, data: body.data || {}, route: ROUTES[body.event] } });\n}\nreturn out;"
      }
