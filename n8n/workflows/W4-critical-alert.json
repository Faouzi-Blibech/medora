{
  "id": "wardCritAlertW04",
  "name": "W4 · Critical-alert fan-out",
  "nodes": [
    {
      "id": "8a1d7c3b-2e44-4f10-8b6a-000000000401",
      "name": "From router",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "8a1d7c3b-2e44-4f10-8b6a-000000000402",
      "name": "One message per recipient",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "// event alert.critical: {alert_id, patient_first_name, bed, kind, news2, message, nurse_chat_ids[], doctor_chat_id}\n// The message names the bed only: no patient name, score or vitals leave the server.\n// Demo routing: staff alerts go to every number in WARD_WHATSAPP_STAFF (comma-separated, country code first).\nconst staff = () => [...new Set(($env.WARD_WHATSAPP_STAFF || '').split(',').map(s => s.replace(/\\D/g, '')).filter(Boolean))];\nconst out = [];\nfor (const item of $input.all()) {\n  const d = item.json.data || {};\n  const text = `Medora: critical alert, bed ${d.bed ?? '?'}. Open Medora now.`;\n  for (const to of staff()) out.push({ json: { to, text, alert_id: d.alert_id } });\n}\nreturn out;"
      }
    },
    {
      "id": "8a1d7c3b-2e44-4f10-8b6a-000000000403",
      "name": "WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WAHA_URL }}/api/sendText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{ $env.WAHA_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ session: 'default', chatId: $json.to + '@c.us', text: $json.text, linkPreview: false }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 15000
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "From router": {
      "main": [
        [
          {
            "node": "One message per recipient",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One message per recipient": {
      "main": [
        [
          {
            "node": "WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Africa/Tunis"
  },
  "pinData": {},
  "tags": []
}
